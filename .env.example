# Copy to .env and fill in. Never commit .env.
PAJ_API_KEY=
PAJ_EMAIL=
# Optional settings (leave empty to turn off)
PAYBOT_FEE_USDC=
PAYBOT_MAX_NGN=
PAYBOT_SOL_CREDENTIAL=
SOLANA_RPC_URL=

# Hosted service (Render). Set these in Render's Environment tab, not here.
# PUBLIC_URL=https://your-service.onrender.com
# PAJ_SESSION_TOKEN=   (from .paj-session.json)
# STATUS_SECRET=       (any long random string)
# PAY_TO_SOL=          (your Solana wallet that receives the $0.01)
# PAY_TO_EVM=          (your Base wallet that receives the $0.01)
# PRICE=$0.01
